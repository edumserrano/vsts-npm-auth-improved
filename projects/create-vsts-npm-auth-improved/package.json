{
  "name": "create-vsts-npm-auth-improved",
  "version": "1.0.0-alpha.9",
  "packageManager": "npm@12.0.2",
  "author": "Eduardo Serrano",
  "license": "MIT",
  "description": "Configure projects to use vsts-npm-auth-improved",
  "engines": {
    "node": ">=24.18.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.2",
      "onFail": "error"
    }
  },
  "bin": {
    "create-vsts-npm-auth-improved": "cjs/main.js"
  },
  "scripts": {
    "check-required-node-version": "node ../scripts/check-required-version.cjs node 24.18.1",
    "check-required-npm-version": "node ../scripts/check-required-version.cjs npm 12.0.2",
    "preinstall": "npm run check-required-node-version && npm run check-required-npm-version",
    "clean:dist": "rimraf ./dist",
    "clean:tests": "rimraf ./test-reporters",
    "prebuild": "npm run clean:dist",
    "build": "npm run build:lib && npm run build:test",
    "build:lib": "tsc -p ./tsconfig.lib.json",
    "build:test": "tsc -p ./tests/tsconfig.json",
    "copy-package-readme": "cp-cli ./README.md dist/create-vsts-npm-auth-improved/README.md",
    "copy-package-license": "cp-cli ../../LICENSE dist/create-vsts-npm-auth-improved/LICENSE",
    "copy-package-json": "clear-package-json package.json -o dist/create-vsts-npm-auth-improved/package.json",
    "prepack": "npm run build && npm run copy-package-json && npm run copy-package-readme && npm run copy-package-license && mkdirp ./dist/create-vsts-npm-auth-improved-package",
    "pack": "npm pack ./dist/create-vsts-npm-auth-improved --pack-destination ./dist/create-vsts-npm-auth-improved-package && echo Package available at ./dist/create-vsts-npm-auth-improved-package",
    "pretest": "npm run clean:tests && npm run test:boundaries",
    "test": "vitest run --coverage",
    "test:boundaries": "node ../scripts/check-test-public-boundary.cjs .",
    "pretest:watch": "npm run clean:tests && npm run test:boundaries && npm run test:setup-test-reporters",
    "test:watch": "concurrently --raw --kill-others \"npx vitest --coverage\" \"npm run test:show-code-coverage\"",
    "pretest:ui": "npm run clean:tests && npm run test:boundaries && npm run test:setup-test-reporters",
    "test:ui": "concurrently --raw --kill-others \"npx vitest --ui --coverage\" \"npm run test:show-code-coverage\"",
    "test:update-snapshots": "vitest run -u",
    "test:show-html-report": "npx vite preview --outDir test-reporters/html-report --open",
    "test:show-code-coverage": "browser-sync start --server ./test-reporters --startPath /code-coverage/html-report/index.html --watch --port=41301 --no-ui",
    "test:setup-test-reporters": "npm run test:create-code-coverage-dir && npm run test:create-code-coverage-index",
    "test:create-code-coverage-dir": "mkdirp ./test-reporters/code-coverage/html-report",
    "test:create-code-coverage-index": "cp-cli ./tests/.index-placeholders/index.code-coverage.html ./test-reporters/code-coverage/html-report/index.html"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@npmcli/config": "^11.0.0",
    "@npmcli/package-json": "^8.0.0",
    "commander": "^15.0.0",
    "globby": "^16.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "browser-sync": "^3.0.4",
    "clean-publish": "^7.1.0",
    "concurrently": "^10.0.4",
    "cp-cli": "^2.0.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "azure-devops",
    "npm",
    "registry",
    "authentication",
    "vsts-npm-auth-improved"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edumserrano/vsts-npm-auth-improved.git",
    "directory": "projects/create-vsts-npm-auth-improved"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
