// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`an unknown Commander command is captured through cliAsync 1`] = `""`;

exports[`an unknown Commander command is captured through cliAsync 2`] = `"error: too many arguments for 'auth'. Expected 0 arguments but got 1: unknown-command."`;

exports[`auth command help text (useOptionAlias: false) 1`] = `
"
Usage: vsts-npm-auth-improved auth [options]
Authenticate on Windows using vsts-npm-auth NPM package
Options:
  -c, --config-path <paths>           Comma-separated paths to .npmrc config
                                      files
  -t, --target-config <path>          Path to the .npmrc that receives
                                      credentials (default: ~/.npmrc)
  -e, --expiration-minutes <minutes>  Token lifetime in whole minutes, up to
                                      525600 (365 days); defaults to 129600 (90
                                      days)
  --read                              Request a token with Packaging (Read)
                                      scope
  --no-read                           Request a token with Packaging (Read &
                                      Write)
  --force                             Force authentication token acquisition
  --no-force                          Do not force authentication token
                                      acquisition
  -h, --help                          display help for command"
`;

exports[`auth command help text (useOptionAlias: true) 1`] = `
"
Usage: vsts-npm-auth-improved auth [options]
Authenticate on Windows using vsts-npm-auth NPM package
Options:
  -c, --config-path <paths>           Comma-separated paths to .npmrc config
                                      files
  -t, --target-config <path>          Path to the .npmrc that receives
                                      credentials (default: ~/.npmrc)
  -e, --expiration-minutes <minutes>  Token lifetime in whole minutes, up to
                                      525600 (365 days); defaults to 129600 (90
                                      days)
  --read                              Request a token with Packaging (Read)
                                      scope
  --no-read                           Request a token with Packaging (Read &
                                      Write)
  --force                             Force authentication token acquisition
  --no-force                          Do not force authentication token
                                      acquisition
  -h, --help                          display help for command"
`;

exports[`auth command version (useOptionAlias: false) 1`] = `
"
<PACKAGE_VERSION>"
`;

exports[`auth command version (useOptionAlias: true) 1`] = `
"
<PACKAGE_VERSION>"
`;
